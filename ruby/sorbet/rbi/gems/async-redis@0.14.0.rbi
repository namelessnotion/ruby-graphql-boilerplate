  # pkg:gem/async-redis#lib/async/redis/protocol/authenticated.rb:29
  def client(stream); end

  # pkg:gem/async-redis#lib/async/redis/protocol/authenticated.rb:26
  def credentials; end
end

# Authentication has failed for some reason.
