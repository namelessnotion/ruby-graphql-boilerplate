# A map that associates one or more ranges with a value for efficient lookup.
#
# pkg:gem/async-redis#lib/async/redis/range_map.rb:10
class Async::Redis::RangeMap
  # Initialize a new RangeMap.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:12
  def initialize; end

  # Add one or more ranges associated with a value to the map.
  # @parameter ranges [Range | Array(Range)] The ranges to map.
  # @parameter value [Object] The value to associate with the ranges.
  # @returns [Object] The added value.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:20
  def add(ranges, value); end

  # Clear all ranges from the map.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:58
  def clear; end

  # Iterate over each mapped value.
  # @yields {|value| ...} Block called for each value.
  #  @parameter value [Object] The value associated with one or more ranges.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:43
  def each; end

  # Find the value associated with a key within any range.
  # @parameter key [Object] The key to find.
  # @yields {...} Block called if no range contains the key.
  # @returns [Object] The value if found, result of block if given, or nil.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:30
  def find(key); end

  # Get a random value from the map.
  # @returns [Object] A randomly selected value, or nil if map is empty.
  #
  # pkg:gem/async-redis#lib/async/redis/range_map.rb:51
  def sample; end
end

# A Redis Sentinel client for high availability Redis deployments.
#
# pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:14
class Async::Redis::SentinelClient
  include ::Protocol::Redis::Methods
  include ::Protocol::Redis::Methods::Generic
  include ::Protocol::Redis::Methods::Connection
  include ::Protocol::Redis::Methods::Server
  include ::Protocol::Redis::Methods::Cluster
  include ::Protocol::Redis::Methods::Geospatial
  include ::Protocol::Redis::Methods::Counting
  include ::Protocol::Redis::Methods::Hashes
  include ::Protocol::Redis::Methods::Lists
  include ::Protocol::Redis::Methods::Scripting
  include ::Protocol::Redis::Methods::Sets
  include ::Protocol::Redis::Methods::SortedSets
  include ::Protocol::Redis::Methods::Strings
  include ::Protocol::Redis::Methods::Streams
  include ::Protocol::Redis::Methods::Pubsub
  include ::Async::Redis::Client::Methods

  # Create a new instance of the SentinelClient.
  #
  # @property endpoints [Array(Endpoint)] The list of sentinel endpoints.
  # @property master_name [String] The name of the master instance, defaults to 'mymaster'.
  # @property master_options [Hash] Connection options for master instances.
  # @property slave_options [Hash] Connection options for slave instances (defaults to master_options if not specified).
  # @property role [Symbol] The role of the instance that you want to connect to, either `:master` or `:slave`.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:27
  def initialize(endpoints, master_name: T.unsafe(nil), master_options: T.unsafe(nil), slave_options: T.unsafe(nil), role: T.unsafe(nil), **options); end

  # Close the sentinel client and all connections.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:65
  def close; end

  # Initiate a failover for the specified master.
  # @parameter name [String] The name of the master to failover.
  # @returns [Object] The result of the failover command.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:76
  def failover(name = T.unsafe(nil)); end

  # Get information about a specific master.
  # @parameter name [String] The name of the master.
  # @returns [Hash] The master information hash.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:93
  def master(name = T.unsafe(nil)); end

  # @attribute [String] The name of the master instance.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:41
  def master_name; end

  # Get information about all masters.
  # @returns [Array(Hash)] Array of master information hashes.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:84
  def masters; end

  # Resolve an address for the specified role.
  # @parameter role [Symbol] The role to resolve (:master or :slave).
  # @returns [Endpoint] The resolved endpoint address.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:49
  def resolve_address(role = T.unsafe(nil)); end

  # @attribute [Symbol] The role of the instance that you want to connect to.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:44
  def role; end

  private

  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:137
  def assign_default_tags(tags); end

  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:162
  def available_slaves(reply); end

  # Override the parent method. The only difference is that this one needs to resolve the master/slave address.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:142
  def make_pool(**options); end

  # Resolve the master endpoint address.
  # @returns [Endpoint | Nil] The master endpoint or nil if not found.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:103
  def resolve_master(options = T.unsafe(nil)); end

  # Resolve a slave endpoint address.
  # @returns [Endpoint | Nil] A slave endpoint or nil if not found.
  #
  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:119
  def resolve_slave(options = T.unsafe(nil)); end

  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:174
  def select_slave(available_slaves); end

  # pkg:gem/async-redis#lib/async/redis/sentinel_client.rb:154
  def sentinels; end
end

