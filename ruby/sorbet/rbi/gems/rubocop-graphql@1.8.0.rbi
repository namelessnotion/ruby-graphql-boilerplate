class RuboCop::GraphQL::Argument
  extend ::RuboCop::AST::NodePattern::Macros

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:30
  def initialize(node); end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:19
