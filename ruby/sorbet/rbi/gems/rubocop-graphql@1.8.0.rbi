  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:14
  def argument_name(param0 = T.unsafe(nil)); end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:24
  def argument_required(param0 = T.unsafe(nil)); end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:38
  def as; end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:73
  def block; end

  # A configured default is always passed, even when the client omits the argument.
  #
  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:61
  def default_value?; end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:65
  def description; end

  # The keyword this argument is passed as to #resolve and friends. `as:` wins when both
  # are given, matching graphql-ruby's `kwargs[:as] ||= inferred_arg_name`.
  #
  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:44
  def keyword; end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:69
  def kwargs; end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:34
  def name; end

  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:28
  def node; end

  # `required: false` is the only value that lets graphql-ruby omit the keyword:
  # `required: :nullable` still demands the argument be present, though it may be null.
  #
  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:53
  def optional?; end

  private

  # Mirrors graphql-ruby: a `loads:` argument named `foo_id` arrives as `foo:`, and one
  # named `foo_ids` arrives as `foos:`.
  #
  # pkg:gem/rubocop-graphql#lib/rubocop/graphql/argument.rb:81
