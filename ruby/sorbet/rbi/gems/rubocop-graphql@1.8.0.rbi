  # pkg:gem/rubocop-graphql#lib/rubocop/cop/graphql/object_description.rb:136
  def graphql_base?(const_node); end

  # pkg:gem/rubocop-graphql#lib/rubocop/cop/graphql/object_description.rb:145
  def graphql_namespace?(const_node); end

  # pkg:gem/rubocop-graphql#lib/rubocop/cop/graphql/object_description.rb:128
