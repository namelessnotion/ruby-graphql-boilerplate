DATABASE_URL=postgres://ruby_app:ruby_app@localhost:5432/ruby_app_development?sslmode=disable
CORS_ALLOWED_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Traces export over OTLP to a collector. There is one to run locally now
# (`docker compose --profile observability up -d`, see the README), but it is
# opt-in, and an SDK left on without it just retries exports that can never
# land — so the default stays off and you turn it on for the run that wants
# it: `OTEL_SDK_DISABLED=false bundle exec bin/server`. Structured logging is
# the tier that never needs a collector, and is on either way.
OTEL_SDK_DISABLED=true
LOG_LEVEL=info
