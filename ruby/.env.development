DATABASE_URL=postgres://ruby_app:ruby_app@localhost:5432/ruby_app_development?sslmode=disable
CORS_ALLOWED_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Traces export over OTLP to a collector. Until one runs locally the SDK stays
# off, which costs the app nothing and leaves structured logging — the tier
# that never needs a collector — switched on regardless.
OTEL_SDK_DISABLED=true
LOG_LEVEL=info
