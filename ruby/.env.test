DATABASE_URL=postgres://stack_test_user:stack_test_user@localhost:5432/stack_test?sslmode=disable
REDIS_URL=redis://localhost:6379/1
# The suite runs on the no-op tracer, so it needs no collector; specs that
# assert on spans install an in-memory exporter for their own duration.
OTEL_SDK_DISABLED=true
# Log lines are asserted through the formatter, not read off stdout, so the
# real logger stays quiet during a run.
LOG_LEVEL=fatal
