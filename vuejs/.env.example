# GraphQL endpoint the Apollo client sends operations to.
# VITE_GRAPHQL_URL=http://localhost:9292/graphql

# OTLP/HTTP collector origin for browser trace export (see
# docker/otel/otelcol-config.yaml and the `otel` service in compose.yml).
# Unset by default: a developer with no collector running pays no wasted
# export retries — spans still open and close, they just record nothing.
# Start the collector with `docker compose --profile observability up -d`,
# then set this to turn export on.
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
